.artifacts/
bin/
obj/
node_modules/
dist/
coverage/
TestResults/
test-results/
*.tsbuildinfo

# ─── Security: never commit secrets ───────────────────────────────────────────
# All .env files at any directory depth are excluded.
# Copy the relevant .env.example to .env and fill in real values locally.
# Never commit real API keys, connection strings, or signing keys.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
*.user
*.suo
*.log
*.db
*.db-shm
*.db-wal

# Local Netlify folder
.netlify

# Service account key files (Google Cloud / Firebase) — never commit these
*service-account*.json
*serviceaccount*.json
firebase-adminsdk*.json
google-credentials*.json
